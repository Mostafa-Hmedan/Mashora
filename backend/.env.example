# App
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# Database
# ملاحظة: المنفذ 5434 (وليس 5432 الافتراضي) لتفادي تعارض مع PostgreSQL آخر (أو مشروع آخر) على نفس الجهاز
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/mashora?schema=public"

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Booking hold (minutes a slot stays reserved while payment is pending)
BOOKING_HOLD_MINUTES=15

# Payment provider — one of: PAYTABS | HYPERPAY | MOYASAR | TAP
PAYMENT_PROVIDER=MOYASAR
PAYMENT_API_KEY=replace-with-provider-secret-key
PAYMENT_WEBHOOK_SECRET=replace-with-provider-webhook-signing-secret
PAYMENT_CALLBACK_BASE_URL=http://localhost:3000/payments/webhook

# Daily.co (فيديو الجلسات المدمج داخل التطبيق)
DAILY_API_KEY=replace-with-daily-co-api-key

# Firebase Cloud Messaging (إشعارات Push) — service account
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# تخزين ملفات PDF الطبية (محلي حاليًا؛ قابل للاستبدال بـ S3/Firebase Storage لاحقًا)
UPLOADS_ROOT=./uploads
MEDICAL_RECORDS_STORAGE_DIR=./uploads/medical-records
